# ========================================================
# TerraMind Environment Variables Template
# Copy this to .env for local development
# Add these key-value pairs in the Render Dashboard -> Environment
# ========================================================

# Flask Session Key (Generate a random string for production)
SECRET_KEY=your_flask_secret_key_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Google Gemini API Key (for Chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Earth Engine Configuration
EE_PROJECT=terramind-504413
GEE_SERVICE_ACCOUNT_EMAIL=terramind-render@terramind-504413.iam.gserviceaccount.com
# For Render, upload your service account JSON file via "Secret Files" (e.g., /etc/secrets/service_account.json)
GOOGLE_APPLICATION_CREDENTIALS=credentials/service_account.json

# Environment mode (development / production)
FLASK_ENV=production
